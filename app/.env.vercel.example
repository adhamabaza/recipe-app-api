DJANGO_SETTINGS_MODULE=app.settings_vercel
DJANGO_SECRET_KEY=generate-a-unique-random-secret-in-vercel
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
DJANGO_ALLOWED_HOSTS=your-project.vercel.app
BLOB_READ_WRITE_TOKEN=set-by-the-connected-vercel-blob-store
BLOB_PUBLIC_BASE_URL=https://YOUR-STORE.public.blob.vercel-storage.com
VITE_API_BASE_URL=/api
VITE_MAX_IMAGE_BYTES=4194304
